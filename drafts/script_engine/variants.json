 "overrides": {
  "work.thrill.lastnight#1@f": {
   "1": {
    "ko": "민지 누나, 부장님 주무시죠?"
   }
  },
  "trip.romance.cafe#1@mm": {
   "5": {
    "th": "ไม่ได้จีบครับ พูดความจริง คุณยิ้มน่ารักมาก",
    "roman": "마이 다이 찝 크랍, 풋 쾀찡, 쿤 임 나락 막",
    "ko": "작업 아니에요. 사실을 말한 거죠. 웃는 게 정말 멋져요."
   }
  },
  "trip.romance.cafe#1@fm": {
   "5": {
    "th": "ไม่ได้จีบค่ะ พูดความจริง คุณยิ้มน่ารักมาก",
    "roman": "마이 다이 찝 카, 풋 쾀찡, 쿤 임 나락 막",
    "ko": "작업 아니에요. 사실을 말한 거죠. 웃는 게 정말 멋져요."
   }
  },
  "trip.win.tout#1@f": {
   "2": {
    "ko": "진품이 500밧이요, 사장님? 어디서 온 진품이에요?"
   },
   "8": {
    "ko": "그건 살게요. 마침 더웠는데. 두 개요. 사장님도 같이 드세요."
   }
  },
  "move.win.tuktuk#1@f": {
   "2": {
    "ko": "300? 너무 비싸요 기사님. 요만큼 가까운데."
   }
  },
  "trip.thrill.island#1@fm": {
   "5": {
    "speaker": "B",
    "th": "คุณไม่กลัวเหรอครับ อยู่กับคนแปลกหน้า",
    "roman": "쿤 마이 끌루아 러 크랍, 유 깝 콘 쁠랙 나"
   },
   "6": {
    "speaker": "A",
    "th": "ไม่กลัวค่ะ ฉันเรียนมวยไทยมาสิบปี คุณสิควรกลัว",
    "roman": "마이 끌루아 카, 찬 리안 무어이 타이 마 씹 삐, 쿤 씨 쿠언 끌루아"
   },
   "7": {
    "speaker": "B",
    "th": "ฮ่าๆ งั้นผมฝากตัวด้วยนะครับ คืนนี้ทำอะไรดี",
    "roman": "하하, 응안 폼 팍 뚜아 두어이 나 크랍, 큰니 탐 아라이 디"
   },
   "8": {
    "speaker": "A",
    "th": "ซื้อเบียร์ ไปนั่งริมหาด แล้วเล่าความลับกันคนละเรื่อง กล้าไหมคะ",
    "roman": "쓰 비아, 빠이 낭 림 핫, 래우 라오 쾀랍 깐 콘 라 르앙, 끌라 마이 카"
   }
  },
  "us.romance.meetmom#1@*m": {
   "2": {
    "ko": "어서 와요. 태국어도 해요? 핌이 말을 안 하던데."
   },
   "6": {
    "note": "어머니의 진짜 질문 — \"우리 아들 두고 갈 거냐\""
   },
   "7": {
    "ko": "오래 있을 생각입니다. 핌이 저를 내쫓지 않는 한은요."
   }
  },
  "home.status.soi#1@f": {
   "2": {
    "ko": "늘 가던 데요 아저씨. 골목 입구. 늘 그렇듯 20밧이죠?"
   },
   "4": {
    "ko": "고마워요 아저씨. 어제 복권 뭐 나왔어요? 맞았어요?"
   },
   "8": {
    "ko": "아직요. 하나가 부족해요. 태국 애인이 없잖아요. 아저씨가 좀 도와줘요."
   }
  },
  "night.romance.rooftop#1@f*": {
   "4": {
    "th": "ใจป้ำนะ มาคนเดียวเหรอ หรือรอใคร",
    "roman": "짜이 빰 나, 마 콘 디아우 러, 르 러 크라이",
    "note": "ใจป้ำ = 통이 크다, 잘 쏜다 (남자에게는 ใจป๋า 도 쓴다)"
   }
  },
  "night.win.bill#1@f": {
   "2": {
    "ko": "네 손님. 전부 4,500밧입니다."
   },
   "8": {
    "ko": "아닙니다 손님, 죄송합니다. 제가 계산을 잘못했네요. 2,200밧입니다."
   }
  },
  "night.win.exit#1@f": {
   "meta": {
    "title": "제일 세십니다, 저는 이만",
    "characters": {
     "A": "민지",
     "B": "술 취한 옆 테이블 남자"
    }
   },
   "1": {
    "ko": "동생! 이리 와 앉아. 오빠가 살게. 원샷!"
   },
   "2": {
    "ko": "감사합니다. 근데 저 친구랑 왔어요."
   },
   "3": {
    "ko": "친구도 불러. 딱 한 잔인데. 오빠 체면 안 세워 줄 거야?"
   },
   "6": {
    "ko": "더는 못 마셔요. 내일 아침 일찍 운전해야 해서요."
   },
   "8": {
    "ko": "약한 거 맞습니다, 인정. 이 가게에서 제일 세세요. 저는 먼저 실례하겠습니다."
   }
  },
  "phone.romance.ex#1@f*": {
   "5": {
    "th": "ยังเปิดอยู่ ป้ายังถามถึงเธอเลย ว่าสาวเกาหลีหายไปไหน",
    "roman": "양 쁫 유, 빠 양 탐 틍 터 러이, 와 싸오 까올리 하이 빠이 나이",
    "ko": "아직 해. 이모가 네 안부도 묻더라. 그 한국 아가씨 어디 갔냐고."
   }
  },
  "phone.romance.readnoreply#1@fm": {
   "6": {
    "th": "หึงก็บอกว่าหึงสิ น่ารักดี เพื่อนผู้ชายน่ะ สบายใจได้",
    "roman": "흥 꺼 복 와 흥 씨, 나락 디, 프안 푸차이 나, 싸바이짜이 다이",
    "ko": "질투 나면 난다고 해. 귀엽네. 남자애들이야, 안심해."
   }
  },
  "phone.romance.readnoreply#1@mm": {
   "6": {
    "th": "หึงก็บอกว่าหึงสิ น่ารักดี เพื่อนผู้หญิงน่ะ สบายใจได้",
    "roman": "흥 꺼 복 와 흥 씨, 나락 디, 프안 푸잉 나, 싸바이짜이 다이"
   }
  },
  "phone.romance.readnoreply#1@ff": {
   "6": {
    "th": "หึงก็บอกว่าหึงสิ น่ารักดี เพื่อนผู้ชายจ้ะ สบายใจได้",
    "roman": "흥 꺼 복 와 흥 씨, 나락 디, 프안 푸차이 짜, 싸바이짜이 다이",
